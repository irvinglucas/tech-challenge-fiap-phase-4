<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fiap.feedback</groupId>
        <artifactId>tech-challenge-fiap-phase-4</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>notification-handler</artifactId>
    <name>notification-handler</name>
    <description>
        Cloud Function Gen2 (Pub/Sub trigger). Thin inbound adapter that
        decodes urgent-feedback events and delegates to NotifyUrgentFeedback.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.fiap.feedback</groupId>
            <artifactId>common</artifactId>
        </dependency>

        <!-- Quarkus core extension for implementing Google Cloud Functions
             interfaces directly (CloudEventsFunction for Pub/Sub Gen2). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-google-cloud-functions</artifactId>
        </dependency>

        <!-- JSON parsing for the Pub/Sub envelope -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-logging-json</artifactId>
        </dependency>

        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                            <goal>generate-code</goal>
                            <goal>generate-code-tests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
