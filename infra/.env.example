# Copy this file to infra/.env (gitignored) and fill in your values, then run:
#   ./infra/setup.sh

PROJECT_ID=
REGION=southamerica-east1

# Gmail credentials used by the notification-handler and weekly-report to send
# e-mail via smtp.gmail.com:587 STARTTLS.
# Prerequisite: enable 2-Step Verification on the account and generate a
# 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# Recipient address for urgent notifications and weekly reports.
ADMIN_EMAIL=

# Optional overrides:
# URGENT_TOPIC=urgent-feedback
# URGENT_DLQ_TOPIC=urgent-feedback-dlq
